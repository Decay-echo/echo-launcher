; amd_ags_x64.def -- the proxy's export table.
;
; Every export of the real amd_ags_x64.dll (AMD GPU Services; 32 named exports, ordinals 1-32, read from the
; export directory of C:\echo\EchoBinarys\bin\win10\amd_ags_x64.dll) is forwarded to the renamed original,
; amd_ags_x64_orig.dll, with the same ordinal. echovr.exe build 631547 imports four of them (its import
; directory: agsDeInit, agsDriverExtensionsDX12_DeInit, agsDriverExtensionsDX12_Init, agsInit), marked *.
; Forwarding the other 28 costs nothing and keeps any module that resolves the DLL by name working.
;
; A forwarder is resolved by the loader when echovr.exe's imports are snapped: amd_ags_x64_orig.dll is loaded
; from the game folder then. If it is missing the game fails to start before WinMain -- rename first, copy second.
LIBRARY amd_ags_x64
EXPORTS
    agsDeInit                                                      = amd_ags_x64_orig.agsDeInit                                                      @1   ; *
    agsDriverExtensionsDX11_BeginUAVOverlap                        = amd_ags_x64_orig.agsDriverExtensionsDX11_BeginUAVOverlap                        @2
    agsDriverExtensionsDX11_CreateBuffer                           = amd_ags_x64_orig.agsDriverExtensionsDX11_CreateBuffer                           @3
    agsDriverExtensionsDX11_CreateDevice                           = amd_ags_x64_orig.agsDriverExtensionsDX11_CreateDevice                           @4
    agsDriverExtensionsDX11_CreateTexture1D                        = amd_ags_x64_orig.agsDriverExtensionsDX11_CreateTexture1D                        @5
    agsDriverExtensionsDX11_CreateTexture2D                        = amd_ags_x64_orig.agsDriverExtensionsDX11_CreateTexture2D                        @6
    agsDriverExtensionsDX11_CreateTexture3D                        = amd_ags_x64_orig.agsDriverExtensionsDX11_CreateTexture3D                        @7
    agsDriverExtensionsDX11_DestroyDevice                          = amd_ags_x64_orig.agsDriverExtensionsDX11_DestroyDevice                          @8
    agsDriverExtensionsDX11_EndUAVOverlap                          = amd_ags_x64_orig.agsDriverExtensionsDX11_EndUAVOverlap                          @9
    agsDriverExtensionsDX11_GetMaxClipRects                        = amd_ags_x64_orig.agsDriverExtensionsDX11_GetMaxClipRects                        @10
    agsDriverExtensionsDX11_IASetPrimitiveTopology                 = amd_ags_x64_orig.agsDriverExtensionsDX11_IASetPrimitiveTopology                 @11
    agsDriverExtensionsDX11_MultiDrawIndexedInstancedIndirect      = amd_ags_x64_orig.agsDriverExtensionsDX11_MultiDrawIndexedInstancedIndirect      @12
    agsDriverExtensionsDX11_MultiDrawIndexedInstancedIndirectCountIndirect = amd_ags_x64_orig.agsDriverExtensionsDX11_MultiDrawIndexedInstancedIndirectCountIndirect @13
    agsDriverExtensionsDX11_MultiDrawInstancedIndirect             = amd_ags_x64_orig.agsDriverExtensionsDX11_MultiDrawInstancedIndirect             @14
    agsDriverExtensionsDX11_MultiDrawInstancedIndirectCountIndirect = amd_ags_x64_orig.agsDriverExtensionsDX11_MultiDrawInstancedIndirectCountIndirect @15
    agsDriverExtensionsDX11_NotifyResourceBeginAllAccess           = amd_ags_x64_orig.agsDriverExtensionsDX11_NotifyResourceBeginAllAccess           @16
    agsDriverExtensionsDX11_NotifyResourceEndAllAccess             = amd_ags_x64_orig.agsDriverExtensionsDX11_NotifyResourceEndAllAccess             @17
    agsDriverExtensionsDX11_NotifyResourceEndWrites                = amd_ags_x64_orig.agsDriverExtensionsDX11_NotifyResourceEndWrites                @18
    agsDriverExtensionsDX11_NumPendingAsyncCompileJobs             = amd_ags_x64_orig.agsDriverExtensionsDX11_NumPendingAsyncCompileJobs             @19
    agsDriverExtensionsDX11_SetClipRects                           = amd_ags_x64_orig.agsDriverExtensionsDX11_SetClipRects                           @20
    agsDriverExtensionsDX11_SetDepthBounds                         = amd_ags_x64_orig.agsDriverExtensionsDX11_SetDepthBounds                         @21
    agsDriverExtensionsDX11_SetDiskShaderCacheEnabled              = amd_ags_x64_orig.agsDriverExtensionsDX11_SetDiskShaderCacheEnabled              @22
    agsDriverExtensionsDX11_SetMaxAsyncCompileThreadCount          = amd_ags_x64_orig.agsDriverExtensionsDX11_SetMaxAsyncCompileThreadCount          @23
    agsDriverExtensionsDX11_SetViewBroadcastMasks                  = amd_ags_x64_orig.agsDriverExtensionsDX11_SetViewBroadcastMasks                  @24
    agsDriverExtensionsDX12_DeInit                                 = amd_ags_x64_orig.agsDriverExtensionsDX12_DeInit                                 @25  ; *
    agsDriverExtensionsDX12_Init                                   = amd_ags_x64_orig.agsDriverExtensionsDX12_Init                                   @26  ; *
    agsDriverExtensionsDX12_PopMarker                              = amd_ags_x64_orig.agsDriverExtensionsDX12_PopMarker                              @27
    agsDriverExtensionsDX12_PushMarker                             = amd_ags_x64_orig.agsDriverExtensionsDX12_PushMarker                             @28
    agsDriverExtensionsDX12_SetMarker                              = amd_ags_x64_orig.agsDriverExtensionsDX12_SetMarker                              @29
    agsGetCrossfireGPUCount                                        = amd_ags_x64_orig.agsGetCrossfireGPUCount                                        @30
    agsInit                                                        = amd_ags_x64_orig.agsInit                                                        @31  ; *
    agsSetDisplayMode                                              = amd_ags_x64_orig.agsSetDisplayMode                                              @32
